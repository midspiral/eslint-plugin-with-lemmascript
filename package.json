{
  "name": "eslint-plugin-lemmascript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "regen": "npx tsx ../LemmaScript/tools/src/lsc.ts regen --backend=dafny",
    "verify": "../LemmaScript/tools/check.sh dafny",
    "demo": "tsx src/check.ts",
    "lint:demo": "eslint examples/layered/src --config examples/layered/eslint.config.js"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^9.0.0",
    "jiti": "^2.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
